# Copy to .env and adjust. Do NOT commit real secrets.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/web2pdf

# --- Engine / rendering ---
ENABLE_URL_RENDERING=false
MAX_CONCURRENT_RENDERS=3
RECYCLE_AFTER_JOBS=50
RENDER_TIMEOUT_MS=15000
MAX_HTML_BYTES=10485760
MAX_OUTPUT_BYTES=52428800
OUTPUT_TTL_SECONDS=86400

# --- Storage ---
STORAGE_DIR=./var/storage

# --- Reading packs (Day 4) ---
MAX_PACK_ITEMS=25

# --- Signed output downloads ---
# Required in production: without it a random per-process secret is used and
# outstanding download links stop working after a restart.
DOWNLOAD_SIGNING_SECRET=
DOWNLOAD_URL_TTL_SECONDS=86400
# Origin used to build absolute download links returned to API clients.
PUBLIC_BASE_URL=http://localhost:8000
# NOTE: Downloads are served via this application-level HMAC-signed endpoint.
# R2-native presigned URLs are deferred for production and not used yet.

# --- Browser extension CORS ---
# Comma-separated chrome-extension:// origins allowed in production, e.g.
# chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Leave blank in development: any unpacked extension id is allowed automatically
# (chrome-extension:// only -- never arbitrary http/https origins).
CORS_EXTENSION_ORIGINS=

# --- Cloudflare R2 (deferred; leave blank to use local storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=

# --- Observability (disabled when blank) ---
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Misc ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# --- Stripe billing (leave blank until Stripe test mode is configured) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_OVERAGE_PRICE_ID=
BILLING_SUCCESS_URL=http://localhost:8000/usage?checkout=success
BILLING_CANCEL_URL=http://localhost:8000/usage?checkout=cancelled
BILLING_PORTAL_RETURN_URL=http://localhost:8000/usage
OUTBOUND_WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
